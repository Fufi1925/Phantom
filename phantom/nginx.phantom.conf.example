# Beispiel: Phantom NUR unter /phantom auf deiner Domain
# Altes System bleibt unberührt.

# upstream phantom_upstream {
#     server 127.0.0.1:8787;
# }

location /phantom/ {
    proxy_pass http://127.0.0.1:8787/;   # trailing slash strips /phantom prefix for the app
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /phantom;
}

# Wichtig in Discord Developer Portal → OAuth2 Redirects:
#   https://DEINE-DOMAIN/phantom/auth/callback
#
# Und in .env:
#   PHANTOM_BASE_URL=https://DEINE-DOMAIN/phantom
