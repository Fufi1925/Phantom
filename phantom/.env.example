# ═══════════════════════════════════════════════════════════
#  PHANTOM — eigenes System unter /phantom
#  Niemals University-Bot Tokens/Keys hier mischen.
# ═══════════════════════════════════════════════════════════

# Öffentliche Basis-URL inkl. Pfad-Prefix (ohne Slash am Ende)
# Production:
PHANTOM_BASE_URL=https://DEINE-DOMAIN.de/phantom
# Lokal nur zum Testen:
# PHANTOM_BASE_URL=http://127.0.0.1:8787/phantom

# Interner Secret-Key für Sessions (lang & zufällig, mind. 32 Zeichen)
PHANTOM_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_64_CHARS_MIN

# Cookie nur unter /phantom
PHANTOM_COOKIE_NAME=phantom_session
PHANTOM_COOKIE_PATH=/phantom
PHANTOM_SESSION_MAX_AGE=604800

# ── Discord OAuth2 (EIGENE Application — nicht University) ──
# Developer Portal → OAuth2
# Redirect EXAKT:
#   https://DEINE-DOMAIN.de/phantom/auth/callback
# Scopes (automatisch im Code): identify guilds guilds.join
PHANTOM_DISCORD_CLIENT_ID=
PHANTOM_DISCORD_CLIENT_SECRET=

# ── Phantom Ticket-Bot (EIGENER Bot-Token) ──
PHANTOM_BOT_TOKEN=
PHANTOM_BOT_OWNER_IDS=

# Branding
PHANTOM_BRAND_NAME=Phantom
PHANTOM_FOOTER=Powered by University

# Server bind (hinter Nginx/Caddy)
PHANTOM_HOST=0.0.0.0
PHANTOM_PORT=8787

# SQLite (relativ zu phantom/ oder absolut)
PHANTOM_DB_PATH=data/phantom.db
